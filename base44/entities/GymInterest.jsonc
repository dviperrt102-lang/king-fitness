{
  "name": "GymInterest",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the man interested in the future gym"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address for gym updates"
    }
  },
  "required": [
    "name",
    "email"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}