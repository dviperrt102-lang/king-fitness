{
  "name": "Devotional",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Title of the devotional"
    },
    "publish_date": {
      "type": "string",
      "format": "date"
    },
    "scripture_reference": {
      "type": "string",
      "description": "e.g., 'Proverbs 27:17'"
    },
    "scripture_text": {
      "type": "string",
      "description": "The full text of the scripture"
    },
    "body": {
      "type": "string",
      "description": "The main content of the devotional"
    },
    "author": {
      "type": "string",
      "description": "Author of the devotional"
    },
    "image_url": {
      "type": "string",
      "description": "URL for a relevant image for the devotional"
    }
  },
  "required": [
    "title",
    "publish_date",
    "scripture_reference",
    "body"
  ]
}