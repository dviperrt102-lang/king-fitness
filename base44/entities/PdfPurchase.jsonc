{
  "name": "PdfPurchase",
  "type": "object",
  "properties": {
    "stripe_session_id": {
      "type": "string",
      "description": "Stripe Checkout session ID for this order"
    },
    "email": {
      "type": "string",
      "description": "Buyer email as provided at checkout"
    },
    "amount_total": {
      "type": "number",
      "description": "Amount charged in the smallest currency unit"
    },
    "currency": {
      "type": "string",
      "description": "Currency code, e.g. usd"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid"
      ],
      "enumColors": [
        "yellow",
        "green"
      ],
      "default": "pending",
      "description": "Server-verified payment status"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time",
      "description": "When payment was confirmed"
    }
  },
  "required": [
    "stripe_session_id",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}