{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "author_name": {
      "type": "string",
      "description": "Display name of the member who posted"
    },
    "message": {
      "type": "string",
      "description": "Plain text message body"
    }
  },
  "required": [
    "author_name",
    "message"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}