{
  "name": "BookNotifySignup",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "First name of the man who wants to know when the paperback is live"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address to notify when the paperback releases"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}